<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activity.PrivacyActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="50dp"
        >

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/privacytextId"
            android:textSize="18sp"
            android:text="Hello"
            android:textColor="@color/black"
            android:padding="10dp"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="20dp"
            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/contactEmail"
            android:textSize="20sp"
            android:text="Contact Info"
            android:textColor="@color/black"
            android:padding="10dp"
            />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="10sp"
            >
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/contactEmailIv"
                android:paddingLeft="10sp"
                android:src="@drawable/gmail"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/contactEmailTv"
                android:text="Gmail"
                android:textSize="16sp"
                android:paddingLeft="10sp"
                android:textColor="#267E4E"
                />


        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="10sp"
            >
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/contactFacebookIv"
                android:paddingLeft="10sp"
                android:src="@drawable/facebook"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/contactFacebookTv"
                android:text="Facebook"
                android:paddingLeft="10sp"
                android:textSize="16dp"
                android:textColor="#267E4E"
                />


        </LinearLayout><LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="10sp"
            >
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/contactWhatsappIv"
                android:paddingLeft="10sp"
                android:src="@drawable/whatsapp"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/contactWhatsappTv"
                android:text="WhatsApp"
                android:paddingLeft="10sp"
                android:textSize="16dp"
                android:textColor="#267E4E"
                />


        </LinearLayout>


    </LinearLayout>

</ScrollView>